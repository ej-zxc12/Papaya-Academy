# Xendit Payment Configuration
XENDIT_SECRET_KEY=xnd_development_...  # Your Xendit Secret Key (test or live)

# Base URL for redirects
NEXT_PUBLIC_BASE_URL=http://localhost:3000  # Development
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com  # Production

# Batch Delete Configuration
# Date when batch delete for reports becomes available (YYYY-MM-DD format)
BATCH_DELETE_DATE=2026-04-16

# Firebase Admin Configuration (for server-side operations)
FIREBASE_PROJECT_ID=papayaacademy-system
FIREBASE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
